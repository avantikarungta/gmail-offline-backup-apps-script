# Local-only configuration for scripts/external-r2.js.
# Copy this file to .env and keep the resulting file private (chmod 600).

# Reuse the OAuth grant created by `make login-project`; do not copy tokens here.
CLASP_AUTH_FILE=/absolute/path/to/.clasprc.json
CLASP_AUTH_PROFILE=default
GMAIL_USER_ID=me

# Existing Drive archive used only to locate the checkpointed oversized message.
GMAIL_BACKUP_DRIVE_ROOT_ID=
GMAIL_MESSAGE_ID=

# Browser fallback for a Gmail message that exceeds Apps Script response limits.
# `make external-select-download` writes the absolute path after exactly one
# recent .eml has been downloaded through Gmail's "Download message" action.
LOCAL_EML_PATH=
EXTERNAL_DOWNLOAD_DIR=~/Downloads
EXTERNAL_DOWNLOAD_MAX_AGE_MINUTES=30

# Cloudflare R2 S3-compatible binding. This credential must be able to read,
# create, HEAD, and delete objects below the isolated key prefix.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SESSION_TOKEN=
R2_ADDRESSING_STYLE=PATH

# For a production paused-checkpoint repair, this must equal the Apps Script
# ROOT_FOLDER_NAME. Repair verifies the paused checkpoint and canonical object.
R2_ARCHIVE_ROOT_NAME="Gmail Offline Backup"

# For the isolated one-message proof commands, keep this separate from the
# partial Drive archive and any future production R2 archive.
R2_KEY_PREFIX=gmail-backup-oversize-proof
